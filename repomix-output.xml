// js/grafico.js - Motor do Gráfico de Altimetria

let chartInstancia = null;

export function renderizarGrafico(todosPontos) {
    const painel = document.getElementById('painel-grafico');
    
    // Se não houver traçado suficiente, esconde o painel
    if (!todosPontos || todosPontos.length < 2) {
        painel.style.display = 'none';
        return;
    }

    painel.style.display = 'block';

    let distAcumulada = 0;
    const labelsEixoX = [];
    const dadosElevacaoY = [];

    // Calcula a distância ponto a ponto e associa à elevação
    for (let i = 0; i < todosPontos.length; i++) {
        if (i > 0) {
            const ptAnterior = L.latLng(todosPontos[i-1][0], todosPontos[i-1][1]);
            const ptAtual = L.latLng(todosPontos[i][0], todosPontos[i][1]);
            distAcumulada += ptAnterior.distanceTo(ptAtual);
        }
        
        // Formata a distância em KM para o rótulo inferior
        labelsEixoX.push((distAcumulada / 1000).toFixed(2));
        
        // A elevação agora está na posição [2] do array de coordenadas
        dadosElevacaoY.push(todosPontos[i][2] || 0);
    }

    const ctx = document.getElementById('grafico-elevacao').getContext('2d');

    // Se o gráfico já existe, apenas atualiza os dados para ser animado e leve
    if (chartInstancia) {
        chartInstancia.data.labels = labelsEixoX;
        chartInstancia.data.datasets[0].data = dadosElevacaoY;
        chartInstancia.update();
    } else {
        // Cria o gráfico na primeira vez
        chartInstancia = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labelsEixoX,
                datasets: [{
                    label: 'Elevação (m)',
                    data: dadosElevacaoY,
                    borderColor: '#4CAF50',
                    backgroundColor: 'rgba(76, 175, 80, 0.2)',
                    borderWidth: 2,
                    fill: true,
                    pointRadius: 0, // Oculta as bolinhas nos vértices para ficar "clean"
                    tension: 0.1  // Curva leve
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            title: function(context) { return context[0].label + ' km'; },
                            label: function(context) { return ' Alt: ' + context.parsed.y + 'm'; }
                        }
                    }
                },
                scales: {
                    x: { ticks: { maxTicksLimit: 15 } },
                    y: { beginAtZero: false }
                }
            }
        });
    }
}
