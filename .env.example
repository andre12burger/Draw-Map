# Porta HTTP do Web Service (padrão: 3000)
PORT=3000

# Ambiente: development | production | test
NODE_ENV=development

# E-mail de contato enviado no User-Agent das APIs públicas (Nominatim/BRouter).
# A política de uso do Nominatim exige identificação do cliente.
CONTACT_EMAIL=seu-email@exemplo.com

# URLs dos serviços externos (sobrescreva para testar ou usar outro servidor)
BROUTER_URL=https://brouter.de/brouter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Tempo máximo de espera das APIs externas, em milissegundos
UPSTREAM_TIMEOUT_MS=12000

# Limite de requisições por IP na API local
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Confie no cabeçalho X-Forwarded-For apenas quando atrás de um proxy reverso
TRUST_PROXY=false
